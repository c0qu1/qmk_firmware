        "pin": "A2"
    },
    "rgblight": {
        "led_count": 3,
        "sleep": true,
        "animations": {
            "twinkle": true,
            "knight": true
        },
        "layers": {
            "max": 5,
            "enabled": true
        },
        "max_brightness": 64,
        "led_map": [2, 1, 0]
