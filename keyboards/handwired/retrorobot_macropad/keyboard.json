{
    "keyboard_name": "retrorobot_macropad",
    "manufacturer": "c0qu1",
    "url": "https://github.com/c0qu1/qmk_firmware.git",
    "maintainer": "c0qu1",
    "usb": {
        "device_version": "0.0.1",
        "pid": "0x0470",
        "vid": "0x6330"
    },
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP20", "pin_b": "GP18"},
            {"pin_a": "GP21", "pin_b": "GP19"}
        ]
    },
    "qmk": {
        "locking": {
            "enabled": true,
            "resync": true
        }
    },
    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "cols": [
            "GP3",
            "GP2",
            "GP1",
            "GP0"
        ],
        "rows": ["GP4", "GP5", "GP6"]
    },
    "audio": {
        "pins": ["GP16"],
        "default": {
            "on": true,
            "clicky": true
        }
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "debounce": 5,
    "bootmagic": {
        "matrix": [1, 3]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                { "matrix": [0, 0], "x": 0, "y": 0 },
                { "matrix": [0, 3], "x": 3, "y": 0 },

                { "matrix": [1, 0], "x": 0, "y": 1 },
                { "matrix": [1, 1], "x": 1, "y": 1 },
                { "matrix": [1, 2], "x": 2, "y": 1 },
                { "matrix": [1, 3], "x": 3, "y": 1 },

                { "matrix": [2, 0], "x": 0, "y": 2 },
                { "matrix": [2, 1], "x": 1, "y": 2 },
                { "matrix": [2, 2], "x": 2, "y": 2 },
                { "matrix": [2, 3], "x": 3, "y": 2 }
            ]
        }
    }
}
